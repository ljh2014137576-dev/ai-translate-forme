{
  "manifest_version": 3,
  "name": "AI 网页翻译 (DeepSeek)",
  "version": "0.2.0",
  "description": "调用 DeepSeek 大模型，一键把整个网页的可见文本翻译为目标语言，支持三种显示模式、页面翻译缓存与 token 用量统计。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI 网页翻译 (DeepSeek)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Alt+T" },
      "description": "翻译当前页面"
    }
  }
}